meta {
  name: Get token
  type: http
  seq: 1
}

post {
  url: {{keycloakUrl}}/realms/planelyapp/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: planelyapp-panel
  username: {{username}}
  password: {{password}}
}

vars:post-response {
  token: res.body.access_token
}

docs {
  Development only: the realm of development allows the password grant for this client so that a token is easy to get.
  The token lives for a few minutes; run this request again when another one answers 401.
}
