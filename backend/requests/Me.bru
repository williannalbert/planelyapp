meta {
  name: Me
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/me
  body: none
  auth: inherit
}

script:post-response {
  if (res.body.companyId) {
    bru.setVar("companyId", res.body.companyId);
  }
}

docs {
  Who is acting, as the Api sees it. 403 User.NotRegistered means the token was accepted but no user of the platform has this subject. For a user of a company, saves its company in companyId.
}
