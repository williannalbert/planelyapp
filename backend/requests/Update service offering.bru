meta {
  name: Update service offering
  type: http
  seq: 52
}

put {
  url: {{baseUrl}}/companies/{{companyId}}/service-offerings/{{serviceOfferingId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Haircut",
    "durationMinutes": 45,
    "description": "Classic cut",
    "categoryId": "{{serviceCategoryId}}"
  }
}

docs {
  Company administrator only. Replaces the details: a categoryId left out takes the service out of its category.
}
