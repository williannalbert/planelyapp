meta {
  name: Update customer profile
  type: http
  seq: 36
}

put {
  url: {{baseUrl}}/companies/{{companyId}}/customers/{{customerId}}/profile
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Ana Souza",
    "cpf": "52998224725",
    "birthDate": "1990-05-17",
    "preferredLanguage": "pt-BR"
  }
}

docs {
  Replaces the whole profile: a field left out is cleared.
}
